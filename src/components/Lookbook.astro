---
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import { lookbook } from '../data/lookbook';
import { site } from '../config/site';

const WIDTHS = [320, 480, 640, 800, 1000, 1300];
const widthsFor = (max: number) => [...WIDTHS.filter((w) => w < max), max];
---

<section id="lookbook" class="lookbook" aria-labelledby="lookbook-title">
  <div class="wrap">
    <header class="lookbook__head">
      <h2 id="lookbook-title">Lookbook</h2>
      <p>Piezas que ya pasaron por la arena negra.</p>
    </header>

    <div class="lookbook__frame">
      <ul class="lookbook__grid" role="list">
        {
          lookbook.map((item, i) => (
            <li
              class:list={['lookbook__item', { 'lookbook__item--full': item.full }]}
              style={{
                '--col': item.desktop.col,
                '--cols': item.desktop.cols,
                '--row': item.desktop.row,
                '--rows': item.desktop.rows,
                '--tilt': `${i % 2 ? 4 : -4}deg`,
              }}
            >
              <figure>
                <Picture
                  src={item.src}
                  alt={item.alt}
                  widths={widthsFor(item.src.width)}
                  sizes={`(min-width: 1440px) ${Math.round((item.desktop.cols / 12) * 1344)}px, (min-width: 1024px) ${Math.round((item.desktop.cols / 12) * 94)}vw, ${item.full ? 100 : 50}vw`}
                  formats={['avif', 'webp']}
                  quality={50}
                />
                <figcaption class={`sticker sticker--${item.sticker}`}>{item.label}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lookbook__cta">
      <Button href={site.cuanto}>Encuéntralo en Cuanto</Button>
    </div>
  </div>
</section>

<style>
  .lookbook {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .lookbook__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  h2 {
    font-size: var(--step-4);
  }

  .lookbook__head p {
    color: var(--hueso-70);
    font-size: var(--step-1);
  }

  .lookbook__frame {
    container-type: inline-size;
  }

  .lookbook__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    padding: 0;
    list-style: none;
  }

  .lookbook__item {
    position: relative;
  }

  .lookbook__item--full {
    grid-column: 1 / -1;
  }

  figure {
    position: relative;
    height: 100%;
  }

  .lookbook__item :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .lookbook__item--full :global(img) {
    aspect-ratio: 1;
  }

  .sticker {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
  }

  @media (min-width: 1024px) {
    /* 12 columnas con celdas cuadradas: cada foto ocupa columnas × filas según su proporción. */
    .lookbook__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: calc((100cqi - 11 * var(--gap)) / 12);
    }

    .lookbook__item,
    .lookbook__item--full {
      grid-column: var(--col) / span var(--cols);
      grid-row: var(--row) / span var(--rows);
    }

    /* La foto llena su área de la grilla sin imponer su alto natural. */
    .lookbook__item :global(img),
    .lookbook__item--full :global(img) {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }

    .sticker {
      left: 1rem;
      bottom: 1rem;
    }
  }

  .lookbook__cta {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
</style>
