---
import Cristal from '../assets/logo/logo-cristal.svg';
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <Cristal class="footer__cristal" aria-hidden="true" />
      <div>
        <p class="footer__name">{site.name}</p>
        <p>{site.location.label}, Panamá <span aria-hidden="true">·</span> {site.shipping}</p>
      </div>
    </div>
    <ul class="footer__links" role="list">
      <li><a href={site.cuanto}>Tienda en Cuanto</a></li>
      <li><a href={site.instagram}>Instagram {site.instagramHandle}</a></li>
      {site.whatsapp && <li><a href={site.whatsapp}>WhatsApp</a></li>}
    </ul>
    <p class="footer__copy">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 3px solid var(--neon);
    padding-block: 3rem;
    font-size: var(--step--1);
    color: var(--hueso-70);
  }

  .footer__inner {
    display: grid;
    gap: 2rem;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer__cristal {
    width: auto;
    height: 4rem;
    flex: none;
    color: var(--hueso);
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--hueso);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding: 0;
    list-style: none;
  }

  .footer__links a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--hueso);
    font-weight: 600;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--neon);
  }

  .footer__links a:hover {
    color: var(--neon);
  }

  @media (min-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr auto auto;
      align-items: center;
      gap: 3rem;
    }
  }
</style>
